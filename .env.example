# Local development only. Never commit your real .env file.
PORT=3000
NODE_ENV=development
ADMIN_USER=admin
ADMIN_PASS=CHANGE_TO_A_LONG_UNIQUE_PASSWORD_14_CHARS_MIN
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
COOKIE_SECURE=false
TRUST_PROXY=false
MAX_FILE_MB=10

# Supabase project settings (server-side only; never put these in frontend code)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=query-chat-files

# Supabase Connect > Session pooler connection string (IPv4-compatible)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
